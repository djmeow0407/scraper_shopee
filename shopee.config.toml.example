# Đổi tên thành shopee.config.toml để dùng. Tham số CLI luôn thắng file này.

[scraper]
# Trình duyệt (bỏ trống browser_path để tự dò brave-origin/brave/chrome)
headless = false
# browser_path = "/usr/bin/brave-origin"
# no_sandbox = true
# lang = "vi-VN"
# user_data_dir = "/home/ban/.local/share/shopee-scraper/brave-profile"  # đăng nhập một lần
page_load_wait = 4.0
page_retries = 1

# Tiết chế tốc độ, tăng lên nếu hay dính captcha
delay_min = 3.0
delay_max = 7.0
review_page_delay = 1.5

# Thu thập
review_limit = 30
star_limit_per_type = 10
save_every = 5

# Đường dẫn
output_dir = "out"
categories_csv = "data/shopee_categories.csv"
