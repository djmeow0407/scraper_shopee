# Đổi tên thành shopee.config.toml để dùng. Tham số CLI luôn thắng file này.

[scraper]
# Trình duyệt
headless = false
# chrome_version = 144      # bỏ trống để tự dò từ Chrome đã cài
page_load_timeout = 30
window_size = "1920,1080"
# user_data_dir = "/home/ban/.config/shopee-profile"   # giữ phiên đăng nhập

# Tiết chế tốc độ, tăng lên nếu hay dính captcha
delay_min = 3.0
delay_max = 7.0
review_page_delay = 1.5

# Thu thập
review_limit = 30
star_limit_per_type = 10
save_every = 5

# Đường dẫn
output_dir = "out"
categories_csv = "data/shopee_categories.csv"
